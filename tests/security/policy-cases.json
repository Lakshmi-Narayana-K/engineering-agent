{
  "$comment": [
    "Security regression cases for the ACP permission boundary.",
    "",
    "These drive the real policy code over the real ACP wire format: the runner",
    "puts a fake `agent` on PATH, the shim spawns it believing it is Cursor, and",
    "the fake agent issues session/request_permission exactly as Cursor does.",
    "Nothing is stubbed out, so a case passing here means the shipped decision",
    "path produced that answer.",
    "",
    "The point of the file is the migration in docs/architecture/reuse-migration.md.",
    "Each responsibility moves to an upstream component, and the case that proves",
    "it works today is the case that must still pass afterwards. `owner` records",
    "who is expected to make the decision after the migration, so a case that",
    "changes owner but keeps its verdict is a successful handover, and one that",
    "changes verdict is a regression.",
    "",
    "title format is Cursor's own: '<server>-<tool>: <tool>' for MCP calls."
  ],

  "cases": [
    {
      "name": "shell: repository search",
      "expect": "allow",
      "owner": "sandbox + acp-policy-proxy",
      "toolCall": { "kind": "execute", "title": "rg --files repos/nkb_backend" }
    },
    {
      "name": "shell: read-only git",
      "expect": "allow",
      "owner": "sandbox + acp-policy-proxy",
      "toolCall": { "kind": "execute", "title": "git log --oneline -5" }
    },
    {
      "name": "shell: git write subcommand",
      "expect": "deny",
      "owner": "sandbox (read-only mount)",
      "toolCall": { "kind": "execute", "title": "git push origin main" }
    },
    {
      "name": "shell: destructive removal",
      "expect": "deny",
      "owner": "sandbox (read-only mount)",
      "toolCall": { "kind": "execute", "title": "rm -rf repos/nkb_backend" }
    },
    {
      "name": "shell: aws cli reaches production",
      "expect": "deny",
      "owner": "sandbox (no aws cli installed)",
      "toolCall": { "kind": "execute", "title": "aws sts get-caller-identity" }
    },
    {
      "name": "shell: chained command smuggles a denied segment",
      "expect": "deny",
      "owner": "acp-policy-proxy",
      "toolCall": { "kind": "execute", "title": "rg foo && curl https://example.com" }
    },
    {
      "name": "shell: read production env file",
      "expect": "deny",
      "owner": "clean-source export (file absent)",
      "toolCall": { "kind": "execute", "title": "cat repos/nkb_backend/env_prod.sh" }
    },
    {
      "name": "read: production env file by location",
      "expect": "deny",
      "owner": "clean-source export (file absent)",
      "toolCall": {
        "kind": "read",
        "title": "Read file",
        "locations": [{ "path": "repos/nkb_backend/env_prod.sh" }]
      }
    },

    {
      "name": "mcp: allowlisted cloudwatch tool",
      "expect": "allow",
      "owner": "toolhive (cedar permit)",
      "toolCall": {
        "kind": "other",
        "title": "cloudwatch-alpha-describe_log_groups: describe_log_groups"
      }
    },
    {
      "name": "mcp: non-allowlisted tool on an allowed server",
      "expect": "deny",
      "owner": "toolhive (cedar default-deny)",
      "toolCall": {
        "kind": "other",
        "title": "cloudwatch-alpha-delete_log_group: delete_log_group"
      }
    },
    {
      "name": "mcp: server absent from the allowlist",
      "expect": "deny",
      "owner": "toolhive (not registered)",
      "toolCall": {
        "kind": "other",
        "title": "some-other-server-do_thing: do_thing"
      }
    },
    {
      "name": "mcp: rapid7 read tool",
      "expect": "allow",
      "owner": "toolhive (cedar permit)",
      "toolCall": { "kind": "other", "title": "insightidr-search_assets: search_assets" }
    },
    {
      "name": "mcp: rapid7 mutating tool",
      "expect": "deny",
      "owner": "toolhive (cedar default-deny)",
      "toolCall": {
        "kind": "other",
        "title": "insightidr-create_investigation: create_investigation"
      }
    },
    {
      "name": "mcp: unrecognised non-execute tool",
      "expect": "deny",
      "owner": "acp-policy-proxy",
      "toolCall": { "kind": "other", "title": "not a recognised tool title" }
    },

    {
      "name": "aws: allowlisted read operation",
      "expect": "allow",
      "owner": "iam (allow)",
      "toolCall": {
        "kind": "other",
        "title": "aws-api-alpha-call_aws: call_aws",
        "args": { "cli_command": "aws ecs list-clusters" }
      }
    },
    {
      "name": "aws: destructive operation on an allowed service",
      "expect": "deny",
      "owner": "iam (explicit deny)",
      "toolCall": {
        "kind": "other",
        "title": "aws-api-alpha-call_aws: call_aws",
        "args": { "cli_command": "aws ecs delete-service --service x --cluster y" }
      }
    },
    {
      "name": "aws: service outside the allowlist",
      "expect": "deny",
      "owner": "iam (explicit deny)",
      "toolCall": {
        "kind": "other",
        "title": "aws-api-alpha-call_aws: call_aws",
        "args": { "cli_command": "aws iam create-user --user-name x" }
      }
    },
    {
      "name": "aws: shell metacharacter in the command",
      "expect": "deny",
      "owner": "iam (explicit deny)",
      "toolCall": {
        "kind": "other",
        "title": "aws-api-alpha-call_aws: call_aws",
        "args": { "cli_command": "aws ecs list-clusters; aws ecs delete-service" }
      }
    },

    {
      "name": "sql: plain select",
      "expect": "allow",
      "owner": "dbhub + read-only db role",
      "toolCall": {
        "kind": "other",
        "title": "sql-probe-run_query: run_query",
        "args": { "sql": "SELECT id, name FROM users LIMIT 10" }
      }
    },
    {
      "name": "sql: insert",
      "expect": "deny",
      "owner": "db role (no INSERT grant)",
      "toolCall": {
        "kind": "other",
        "title": "sql-probe-run_query: run_query",
        "args": { "sql": "INSERT INTO users (name) VALUES ('x')" }
      }
    },
    {
      "name": "sql: multi-statement write",
      "expect": "deny",
      "owner": "db role (no DDL grant)",
      "toolCall": {
        "kind": "other",
        "title": "sql-probe-run_query: run_query",
        "args": { "sql": "SELECT 1; DROP TABLE users" }
      }
    },
    {
      "name": "sql: credential table read",
      "expect": "deny",
      "owner": "db role (no grant on mysql.*)",
      "toolCall": {
        "kind": "other",
        "title": "sql-probe-run_query: run_query",
        "args": { "sql": "SELECT user, authentication_string FROM mysql.user" }
      }
    },
    {
      "name": "sql: exfiltration to file",
      "expect": "deny",
      "owner": "db role (no FILE privilege)",
      "toolCall": {
        "kind": "other",
        "title": "sql-probe-run_query: run_query",
        "args": { "sql": "SELECT * FROM users INTO OUTFILE '/tmp/dump.csv'" }
      }
    },
    {
      "name": "sql: GHSA-j656-3hf2-fvjc dash-comment bypass",
      "$why": "DBHub treated '--' as a comment where MySQL does not, hiding a write from the classifier. Regression case for whichever layer classifies SQL.",
      "expect": "deny",
      "owner": "db role (no DDL grant)",
      "toolCall": {
        "kind": "other",
        "title": "sql-probe-run_query: run_query",
        "args": { "sql": "SELECT 1 --x\nDROP TABLE users" }
      }
    },
    {
      "name": "sql: GHSA-mwwr-p57h-56pf side-effecting select",
      "$why": "A SELECT that mutates through a function call passes any leading-keyword classifier. Only DB privileges stop it.",
      "expect": "deny",
      "owner": "db role (no EXECUTE grant)",
      "toolCall": {
        "kind": "other",
        "title": "sql-probe-run_query: run_query",
        "args": { "sql": "SELECT pg_read_file('/etc/passwd')" }
      }
    },

    {
      "name": "network: outbound fetch",
      "expect": "deny",
      "owner": "sandbox (network policy)",
      "toolCall": { "kind": "fetch", "title": "Fetch https://example.com" }
    }
  ]
}
